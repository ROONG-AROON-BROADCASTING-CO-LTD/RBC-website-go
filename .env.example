# Set this in .env.local for development and in your deployment's secret store.
# Never commit a real connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Create a Google OAuth 2.0 Web application client. Register this exact URI
# under Authorized redirect URIs. Keep the client secret server-side only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Partner email verification. Verify the sender domain in Resend first.
# Create a send-only API key and keep both secrets server-side.
RESEND_API_KEY=
EMAIL_FROM="RBC GO <no-reply@YOUR_DOMAIN>"
PARTNER_OTP_SECRET=

# Omise sandbox only. Keep secret keys server-side. Set APP_BASE_URL to the
# public HTTPS origin in deployment so 3-D Secure can return to this app.
APP_BASE_URL=http://localhost:3000
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
OMISE_WEBHOOK_SECRET=

