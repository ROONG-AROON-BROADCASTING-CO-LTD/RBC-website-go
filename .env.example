# Set this in .env.local for development and in your deployment's secret store.
# Never commit a real connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Supabase shared pooler hosts automatically use the bundled Supabase root CA.
# Optional PEM CA override for another provider or certificate rotation.
# Accepts actual newlines or literal \n. Never use a NEXT_PUBLIC_ prefix.
DATABASE_SSL_CA=

# Create a Google OAuth 2.0 Web application client. Register this exact URI
# under Authorized redirect URIs. Keep the client secret server-side only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Email OTP, partner verification, password reset and notifications.
# Gmail: enable 2-Step Verification and create an App Password (not your login
# password). Keep it only in this file / your deployment secret store.
EMAIL_PROVIDER=gmail
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional for Gmail. If set, its address must match GMAIL_USER.
EMAIL_FROM=
# Alternative provider: EMAIL_PROVIDER=resend, with a verified sender domain.
RESEND_API_KEY=
# Shared HMAC key for customer and partner OTP; generate 32+ random characters.
PARTNER_OTP_SECRET=
JOBS_SECRET=

# Omise sandbox only. Keep secret keys server-side. Set APP_BASE_URL to the
# public HTTPS origin in deployment so 3-D Secure can return to this app.
APP_BASE_URL=http://localhost:3000
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
OMISE_WEBHOOK_SECRET=
OMISE_MODE=test
ENABLE_LIVE_PAYMENTS=false
# Commission is managed in Staff > Business overview (database, defaults to 10%).
ENABLE_PUBLIC_INDEXING=false
SUPPORT_EMAIL=

# Phone numbers are contact details. Email OTP replaces SMS sign-in.

